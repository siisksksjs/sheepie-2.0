NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# PostHog collects traffic for /bio (visitors, referrers, device, geo).
# The project API key is public by design; it can only write events.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SHEEPIE_WHATSAPP_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BIO_ANALYTICS_RATE_SECRET=
BIO_ANALYTICS_ALLOWED_ORIGINS=https://sheepiesleep.com,https://www.sheepiesleep.com
BIO_ANALYTICS_TRUST_PROXY_HEADERS=false

# Meta Pixel + Conversions API (marketplace click tracking).
# NEXT_PUBLIC_META_PIXEL_ID and META_PIXEL_ID hold the same pixel/dataset ID.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code while verifying.
META_TEST_EVENT_CODE=
# Website-only marketplace voucher shown on product pages.
NEXT_PUBLIC_WEBSITE_VOUCHER_CODE=SHEEPIEWEB
